# =============================================================================
#  NightMC - konfiguracja budowania
# =============================================================================
#  Skopiuj ten plik jako `.env` i uzupełnij PRAWDZIWYMI wartościami.
#  Plik `.env` jest w .gitignore i NIGDY nie trafia do repozytorium ani do EXE
#  w postaci sekretu - poniższe wartości to identyfikatory publiczne.
#
#  Wartości są wstrzykiwane do bundle'a w czasie budowania przez
#  scripts/build.mjs (esbuild `define`). Zmiana wymaga ponownego buildu.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Microsoft Entra ID (logowanie kont Premium)
# -----------------------------------------------------------------------------
# GDZIE TO WZIĄĆ:
#   1. Wejdź na https://entra.microsoft.com  ->  Applications  ->  App registrations
#   2. "New registration", nazwa np. "NightMC Launcher"
#   3. Supported account types: "Personal Microsoft accounts only"
#      (albo "Accounts in any organizational directory and personal Microsoft accounts")
#   4. Redirect URI: platforma "Mobile and desktop applications",
#      wpisz DOKŁADNIE:  http://localhost
#      (NightMC uruchamia lokalny serwer pętli zwrotnej na losowym porcie;
#       Entra dla aplikacji desktopowych akceptuje dowolny port na http://localhost)
#   5. Po utworzeniu skopiuj "Application (client) ID" i wklej poniżej.
#   6. NIE twórz client secret. Aplikacja desktopowa jest klientem publicznym.
#   7. W "Authentication" włącz "Allow public client flows" = Yes.
#
# UWAGA: aby łańcuch Xbox Live -> XSTS -> Minecraft Services działał, aplikacja
# musi mieć przyznany dostęp do Minecraft API przez Mojang/Microsoft. Do czasu
# przyznania dostępu logowanie zwróci błąd z Xbox/XSTS - NightMC pokaże wtedy
# czytelny komunikat, a profile Offline / Non-Premium działają bez tego.
NIGHTMC_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# 2. Aktualizacje przez GitHub Releases
# -----------------------------------------------------------------------------
# Format: wlasciciel/repozytorium
# GDZIE TO WZIĄĆ: adres Twojego repo, np. https://github.com/aleks/nightmc
#                 -> wpisz "aleks/nightmc"
# Puste = sprawdzanie aktualizacji wyłączone.
NIGHTMC_UPDATE_REPO=Gramolis/NightMC

# Opcjonalnie: publiczny klucz Ed25519 (base64, 32 bajty) do weryfikacji podpisu
# pliku NightMC.exe. W EXE trafia WYŁĄCZNIE klucz publiczny.
# Klucz prywatny trzymaj w sekretach CI (NIGHTMC_UPDATE_PRIVKEY) - nigdy w repo.
# Wygenerowanie pary kluczy:  node scripts/gen-update-keys.mjs
NIGHTMC_UPDATE_PUBKEY=

# -----------------------------------------------------------------------------
# 3. Aktualności (statyczny JSON po HTTPS)
# -----------------------------------------------------------------------------
# Może to być plik na GitHub Pages albo raw.githubusercontent.com.
# Puste = zakładka Aktualności pokaże informację o braku konfiguracji
# (brak aktualności NIGDY nie blokuje launchera).
NIGHTMC_NEWS_URL=https://raw.githubusercontent.com/Gramolis/NightMC/main/news.json

# =============================================================================
# 4. Podpisywanie kodu Windows - TYLKO w sekretach CI, nie tutaj!
# =============================================================================
#  W GitHub -> Settings -> Secrets and variables -> Actions dodaj:
#     WIN_CSC_LINK            = certyfikat .pfx zakodowany w base64
#     WIN_CSC_KEY_PASSWORD    = hasło do certyfikatu
#  electron-builder odczyta je automatycznie ze zmiennych środowiskowych.
#  Certyfikat ani hasło NIE MOGĄ trafić do repozytorium.
# =============================================================================

# =============================================================================
# 5. CurseForge API (opcjonalne)
# =============================================================================
#  NightMC NIE zawiera klucza CurseForge. Jeżeli chcesz wyszukiwania online,
#  wpisz własny klucz w aplikacji: Ustawienia -> CurseForge -> Klucz API.
#  Klucz jest szyfrowany i trzymany w magazynie poświadczeń Windows,
#  nigdy w tym pliku, w repozytorium ani w EXE.
# =============================================================================
