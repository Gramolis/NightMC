{
  "name": "nightmc",
  "version": "1.0.0",
  "description": "NightMC - launcher Minecraft Java Edition (Premium + Offline/Non-Premium)",
  "private": true,
  "author": "NightMC",
  "license": "MIT",
  "main": "out/main/index.cjs",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:exe": "npm run build && electron-builder --win --x64 --publish never",
    "build:nsis": "npm run build && electron-builder --win nsis --x64 --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/make-icon.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "fast-xml-parser": "^4.5.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "zustand": "^5.0.4"
  }
}
